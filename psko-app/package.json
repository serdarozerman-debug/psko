{
  "name": "psko-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --require tsx/cjs --test --test-reporter=spec $(find src \\( -name '*.test.ts' -o -name '*.test.tsx' \\) ! -name '*.route.test.ts' | sort)",
    "test:routes": "jest --config jest.config.js --runInBand --forceExit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "dotenv -e .env.local -- npx tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "jose": "^6.2.3",
    "next": "14.2.35",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jest": "^29.7.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.9",
    "tsx": "^4.22.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
